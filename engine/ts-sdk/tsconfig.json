{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@xyber-labs/0-100-devnet": ["../ts-sdk/src/engine"]
    }
  },
  "include": [
    "src/**/*",
    "idl/**/*",
    "types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
