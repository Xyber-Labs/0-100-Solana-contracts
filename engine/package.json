{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "build": "anchor build && cp target/types/engine.ts ts-sdk/idl/engine.ts && cp target/idl/engine.json ts-sdk/idl/engine.json && cd ts-sdk && yarn install && yarn build",
    "dump:raydium": "bash ggbb/dump-raydium.sh",
    "test:litesvm": "ts-mocha -p ./tsconfig.json -t 1000000 ggbb/litesvm.ts",
    "test:litesvm:basic": "ts-mocha -p ./tsconfig.json -t 1000000 ggbb/litesvm.ts --grep 'raydium clmm|Full flow' --invert",
    "test:litesvm:raydium": "yarn dump:raydium && ts-mocha -p ./tsconfig.json -t 1000000 ggbb/raydium-clmm.test.ts",
    "test:litesvm:raydium-sdk": "yarn dump:raydium && ts-mocha -p ./tsconfig.json -t 1000000 tests/raydium-sdk-test.ts",
    "test:litesvm:full": "ts-mocha -p ./tsconfig.json -t 1000000 ggbb/litesvm.ts --grep 'Full flow'",
    "test:litesvm:dispatcher": "ts-mocha -p ./tsconfig.json -t 1000000 ggbb/income-dispatcher.ts",
    "test:anchor:raydium": "anchor test --skip-build --skip-local-validator -- --grep 'engine anchor - raydium clmm'",
    "script:local-flow": "ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 ANCHOR_WALLET=~/.config/solana/id.json ts-node --no-cache scripts/run-local-flow.ts",
    "script:remote-flow": "ANCHOR_PROVIDER_URL=http://10.186.0.84:8899 ANCHOR_WALLET=~/.config/solana/id.json ts-node scripts/run-local-flow.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@raydium-io/raydium-sdk": "^1.3.1-beta.58",
    "@raydium-io/raydium-sdk-v2": "^0.2.30-alpha",
    "@solana/spl-token": "^0.4.14",
    "@xyber-labs/0-100-sdk": "file:./ts-sdk",
    "bs58": "^6.0.0",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "anchor-litesvm": "^0.2.1",
    "big-integer": "^1.6.51",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
